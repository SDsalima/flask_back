{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask (open in default browser)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "FLASK_DEBUG": "1" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on (https?://[^ ]+)",
        "uriFormat": "%s"
      }
    }
  ]
}
